    "outcome": "Flips featureRoutingFirst but leaves both mixed-mask runs at 4.320625%. Reverted; no scheduler change remains.",
    "patchText": "diff --git a/static/inverse/core/direct/feature-seeds.js b/static/inverse/core/direct/feature-seeds.js\nindex 88f453d8..48f987cb 100644\n--- a/static/inverse/core/direct/feature-seeds.js\n+++ b/static/inverse/core/direct/feature-seeds.js\n@@ -19,6 +19,14 @@ export function interiorFeatureIndices(source,features,missed,cfg){\n   }));\n }\n \n+/** Scheduling only: crop-edge fragments must not give detailed routing\n+ * priority over every ordinary seed. Final audits still use all regions. */\n+export function gridsMissInteriorFeatures(source,finalists,cfg,features){\n+  const interior=interiorFeatureIndices(source,features,features.map((_,i)=>i),cfg).map(i=>features[i]);\n+  return interior.length>0&&!finalists.some(seed=>auditImageFeatures(source,\n+    gridMask(seed.model,source.resolution,seed.phase,seed.floor),cfg.width,interior).passed);\n+}\n+\n export function initializeFeatureSeeds({source,features,missed,counts,cfg,evidence,maximumCount},{expandCounts=true}={}){\n   // Do not create new routings solely to reproduce isolated crop-edge flecks.\n   // They still count in the unchanged final image/feature checks. At least part\ndiff --git a/static/inverse/core/direct/fit.js b/static/inverse/core/direct/fit.js\nindex bdaaa474..eaa86d36 100644\n--- a/static/inverse/core/direct/fit.js\n+++ b/static/inverse/core/direct/fit.js\n@@ -25,7 +25,7 @@ import {initializeTopology,initializeCoarseTopology} from './topology.js';\n import {curvesOf} from '../graph.js';\n import {sourceWeights,initializationMask,hasOnlyObservationWeights} from '../image-reference.js';\n import {resizeObjective} from './image-objective.js';\n-import {initializeFeatureSeeds,initializeFeatureSampling,featureRefinementObjective,interiorFeatureIndices} from './feature-seeds.js';\n+import {initializeFeatureSeeds,initializeFeatureSampling,featureRefinementObjective,interiorFeatureIndices,gridsMissInteriorFeatures} from './feature-seeds.js';\n import {featureDetailPlan} from './feature-details.js';\n import {rerouteFittedBoundary} from './reroute.js';\n import {recoverClampedFeatures} from './clamped-features.js';\n@@ -272,7 +272,8 @@ async function fitIndependent(input,cfg,onProgress,countSearch,cornerRecovery,ma\n   // Otherwise a speculative coarse MILP can consume a quarter of a short\n   // request before the smaller feature graph gets any search or repair time.\n   // Keep coarse routing as a fallback when feature recovery returns no seed.\n-  const featureRoutingFirst=shortBudget&&!weights&&!symmetryRequested&&!fine.some(retainsGridColours);\n+  const featureRoutingFirst=shortBudget&&!weights&&!symmetryRequested&&\n+    (partialPreferredGrid||gridsMissInteriorFeatures(source,fine,cfg,sourceFeatures));\n   if(!deferredRouting&&!featureRoutingFirst)await attemptCoarseRouting();\n   // A local boundary gradient cannot create a remote missing region. Try an\n   // alternate traced routing while there is still time within this search.\n"
  },
