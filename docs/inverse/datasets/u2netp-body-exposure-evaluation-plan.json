    "maximumExtrapolation": 0.05,
    "timeLimitSeconds": 10,
    "trials": 0,
    "target": "mask",
    "methods": [
      "production",
      "fallback"
    ],
    "classifier": "Unchanged RGB mixture classifier",
    "fits": "Both native arms use the same pinned production detections/fits. Freshly fit each selected neural crop with the unchanged 10-second production fitter. No per-photo choice between model outputs; retain all 32 photos and all unresolved/failed fits.",
    "validation": "Independent exported weave error <=3%, original feature checks, geometry/paper checks, production editable conversion and independent editable-paper audit. Visual review of all photos/crops and distinct outputs.",
    "missing": "No manual rescue or result-dependent replacement. Record photo eligibility misclassifications and possible irregular weaving separately without removing them from primary denominators.",
    "fieldPalette": "confidence-weighted"
  },
  "sequence": [
    "Independently reload and audit both completed models, frozen state and saved training predictions.",
    "Compare common 24-photo training diagnostics; do not use them as release evidence.",
    "Infer both models on all 32 fixed source-separated development photos using unchanged publisher inputs and normalization.",
    "Inspect paired saliency, then apply the same reviewed fallback crop policy and RGB classifier to both models, with continuous body-weighted palette estimation.",
    "Replay fresh neural template fits, independent image/feature validation, editable conversion and paper checks. Review every changed crop/result."
  ],
