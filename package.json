		"@sveltejs/eslint-config": "^10.0.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.19.0",
		"canvas": "^3.2.3",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.10.0",
