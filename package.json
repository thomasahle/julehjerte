		"test:inverse:references:browser": "node scripts/inverse/reference-browser-test.mjs",
		"benchmark:inverse:yellow-star": "node scripts/inverse/yellow-star-benchmark.mjs",
		"test:inverse:yellow-star:browser": "node scripts/inverse/yellow-star-browser-test.mjs",
